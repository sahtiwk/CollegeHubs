MONGO_URI=
JWT_SECRET=
ALLOWED_ORIGINS=
PORT=
CORE_TOKEN_ISSUER=
CORE_ACCESS_AUDIENCE=
CORE_ACCESS_TTL_SECONDS=
GOOGLE_CLIENT_ID=
NODE_ENV=
DEMO_RESET_ENABLED=
DEMO_DB_NAME_ALLOWLIST=
# P1.2 branding is registry configuration; no additional environment names.

# P2.1: modules stay gated when ENABLE_MODULES is empty.
APP_ORIGIN=
ENABLE_MODULES=
CORE_MODULE_PRIVATE_KEY=
CORE_MODULE_KEY_ID=
CORE_MODULE_PUBLIC_KEYS=
MODULE_ACCESS_TTL_SECONDS=
MODULE_GRANT_TTL_SECONDS=
CORE_GRANT_BINDING_RETENTION_DAYS=
# P2.2 adds no runtime env name; scoring stays inactive until P6.
# Guard runner only: explicit disposable LOCAL replica-set URI; never an application DB.
GUARD_MONGO_URI=
# P5.1: set false to stop NEW room creation; existing rooms still save/close/recover.
STUDY_ROOMS_ENABLED=

# P6.2: false stops provider network refresh; last-good schedules remain readable.
SCHEDULE_REFRESH_ENABLED=
