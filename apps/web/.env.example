# Browser-visible: never put secrets in a VITE_ name.
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
# Direct Core origin (no /api or /core suffix). HTTPS in deployed builds.
# Local default: http://localhost:5000; fixture: http://localhost:5183.
VITE_CORE_SOCKET_ORIGIN=
# Vite server only. Defaults: local Core :5000 and Learn :5001.
CORE_API_ORIGIN=
LEARN_API_ORIGIN=
ARCADE_API_ORIGIN=
INTERVIEW_API_ORIGIN=
