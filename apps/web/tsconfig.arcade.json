{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/features/arcade/**/*.ts",
    "src/features/arcade/**/*.tsx",
    "src/features/interview/**/*.ts",
    "src/features/interview/**/*.tsx",
    "functions/api/**/*.ts"
  ]
}
